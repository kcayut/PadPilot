#!/usr/bin/env python3
"""PadPilot CLI (padpilot-cli) - Control, inspection, pairing, and status tool."""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

import copy
from core import __version__
from core.autostart import (
    daemon_pids,
    disable_autostart,
    enable_autostart,
    is_autostart_enabled,
    is_daemon_running,
    open_menu_app,
    toggle_autostart,
    stop_daemon,
    start_standalone,
    wait_for_daemon,
)
from core.betterdisplay import BetterDisplayCLI
from core.config import (
    APP_SUPPORT_DIR,
    get_config_file_path,
    get_status_file_path,
    load_config,
    read_status,
    save_config,
)
from core.detector import DisplayDetector
from core.logger import get_log_file_path
from core.models import OperationMode, pairing_key
from core.settings import apply_change
from core.storage import atomic_write, remove_state_file

SOCKET_PATH = APP_SUPPORT_DIR / "padpilot.sock"

MENU_HIDDEN = APP_SUPPORT_DIR / "menu-hidden"


def send_daemon_cmd(cmd: str, timeout: float = 3.0, retries: int = 3, retry_delay: float = 0.1) -> str:
    """Send command to running daemon via Unix socket with brief retry for transient startup races."""
    last_err = ""
    for attempt in range(retries):
        if not SOCKET_PATH.exists():
            last_err = "Socket not found"
            if attempt < retries - 1:
                time.sleep(retry_delay)
                continue
            return "Daemon is not running. (Socket not found)"

        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(timeout)
                s.connect(str(SOCKET_PATH))
                s.sendall((cmd + "\n").encode("utf-8"))
                return s.recv(8192).decode("utf-8")
        except (ConnectionRefusedError, FileNotFoundError) as e:
            last_err = str(e)
            if attempt < retries - 1:
                time.sleep(retry_delay)
                continue
            return f"Daemon is not running. (Connection error: {e})"
        except socket.timeout:
            return "Daemon response timed out; the command may still be running."
        except OSError as e:
            return f"Daemon communication failed: {e}"
    return f"Daemon is not running. ({last_err})"


def cmd_status(args: argparse.Namespace) -> None:
    status = read_status()
    responding = is_daemon_running()
    if args.json:
        print(json.dumps(dict(status or {}, version=__version__, daemon_responding=responding),
                         indent=2, ensure_ascii=False))
        return
    print('Daemon: ' + ('handshake verified' if responding else 'not responding; saved snapshot only'))
    if not status:
        print("No saved status found. Display state is unknown.")
        return

    details = status.get("status_details", {})
    mode = status.get("mode", "unknown")
    icon = status.get("icon", "")

    print(f"\n{icon}  PadPilot Display Status")
    print("=" * 45)
    print(f"Mode:              {mode.upper()}")
    print(f"Physical Display:  {details.get('physical_display', 'None')}")
    print(f"USB iPad:          {details.get('usb_ipad', 'Not Connected')}")
    print(f"Sidecar:           {details.get('sidecar', 'Disconnected')}")
    print(f"Current Main:      {details.get('current_main', 'None')}")
    print("-" * 45)
    print(f"Desired State:     {details.get('desired_role', 'None')}")
    print(f"Actual State:      {details.get('actual_role_satisfied', 'None')}")
    print(f"Reason:            {details.get('reason', 'None')}")
    print(f"Topology Gen:      {details.get('generation', '0')}")
    print("=" * 45 + "\n")


def cmd_set_mode(args: argparse.Namespace) -> None:
    mode_str = args.mode.lower()
    valid_modes = [m.value for m in OperationMode]
    if mode_str not in valid_modes:
        print(f"Invalid mode '{mode_str}'. Must be one of: {', '.join(valid_modes)}")
        sys.exit(1)

    req = json.dumps({"command": "set_mode", "params": {"mode": mode_str}}, ensure_ascii=False)
    resp_raw = send_daemon_cmd(req, timeout=60.0)

    if resp_raw.startswith("Daemon is not running"):
        # Offline configuration mutation
        cfg = load_config()
        old_cfg = copy.deepcopy(cfg)
        cfg.mode = OperationMode(mode_str)
        if not cfg.content_equals(old_cfg):
            cfg.revision += 1
            cfg.updated_at = time.time()
            save_config(cfg)
        print("✓ 設定已儲存；背景服務尚未啟動，將於下次啟動時生效。")
    else:
        try:
            resp = json.loads(resp_raw)
            if resp.get("ok"):
                print(f"✓ 運作模式已切換為：{mode_str} (rev {resp.get('config_revision')})")
            else:
                print(f"ERROR: {resp.get('message') or resp.get('error')}")
                sys.exit(1)
        except json.JSONDecodeError:
            raise RuntimeError(resp_raw)


def cmd_action(args: argparse.Namespace) -> None:
    expected = getattr(args, 'expected_revision', None)
    target_key = getattr(args, 'target_key', None)
    guarded = expected is not None or target_key is not None
    command = json.dumps({'command': args.action, 'expected_revision': expected,
                          'params': {'target_key': target_key}}) if guarded else args.action
    resp = send_daemon_cmd(command, timeout=60.0)
    if "Daemon is not running" in resp and args.action != 'connect_ipad':
        if guarded:
            cfg = load_config()
            if type(expected) is not int or cfg.revision != expected:
                raise RuntimeError('CONFIG_CONFLICT: settings changed; refresh before controlling this iPad.')
            if not cfg.ipad.sidecar_uuid or pairing_key(cfg.ipad.to_dict()) != target_key:
                raise RuntimeError('TARGET_CHANGED: the selected iPad is no longer the control target.')
        # Only an explicit control action starts a stopped service. Merely opening
        # settings and refreshing diagnostics never does so.
        cmd_start(argparse.Namespace(no_menu=True) if guarded else args)
        time.sleep(1.0)
        resp = send_daemon_cmd(command, timeout=60.0)
    if guarded:
        result = json.loads(resp)
        if not result.get('ok'):
            raise RuntimeError(f"{result.get('error', 'ERROR')}: {result.get('message', '')}")
        print(result.get('message', 'OK'))
        return
    if not resp.startswith("OK"):
        if args.action == 'connect_ipad':
            from core.i18n import set_language, tr_message
            set_language(load_config().language)
            reason = resp.removeprefix('ERROR: ')
            if resp.startswith('Daemon is not running'):
                reason = 'PadPilot background service is stopped. Start it from the menu, then try again.'
            raise RuntimeError(tr_message(reason))
        raise RuntimeError(resp)
    print(resp)


def save_pairing(device: dict, activate: bool) -> None:
    submit_settings("save_pairing", {"ipad": device, "activate": activate})


def submit_settings(action: str, payload: dict, expected_revision: Optional[int] = None) -> None:
    req = {
        "command": action,
        "params": payload,
    }
    if expected_revision is not None:
        req["expected_revision"] = expected_revision
    resp_raw = send_daemon_cmd(json.dumps(req, ensure_ascii=False), timeout=60.0)

    if not resp_raw or resp_raw.startswith("Daemon is not running"):
        cfg = load_config()
        if expected_revision is not None and cfg.revision != expected_revision:
            raise RuntimeError(f"CONFIG_CONFLICT: expected revision {expected_revision}, but current is {cfg.revision}")
        bd = BetterDisplayCLI(cfg.betterdisplaycli_path) if action == "set_virtual_display" else None
        old_cfg = copy.deepcopy(cfg)
        apply_change(cfg, action, payload, bd)
        if not cfg.content_equals(old_cfg):
            cfg.revision += 1
            cfg.updated_at = time.time()
            save_config(cfg)
        response = "✓ 設定已儲存；背景服務尚未啟動，將於下次啟動時生效。"
    else:
        try:
            resp = json.loads(resp_raw)
            if not resp.get("ok"):
                if resp.get("error") == "CONFIG_CONFLICT":
                    raise RuntimeError(f"CONFIG_CONFLICT: {resp.get('message')}")
                raise RuntimeError(resp.get("message") or resp.get("error") or "Operation failed")
            response = resp.get("message", "OK: 設定已更新")
        except json.JSONDecodeError:
            if not resp_raw.startswith("OK:"):
                raise RuntimeError(resp_raw)
            response = resp_raw

    print(response)


def cmd_change_settings(args: argparse.Namespace) -> None:
    # JSON over stdin keeps device names out of shell commands.
    raw = sys.stdin.read(8193)
    if len(raw.encode('utf-8')) > 8000:
        raise ValueError("設定資料過長")
    payload = json.loads(raw)
    expected_rev = payload.pop("__expected_revision__", None) if isinstance(payload, dict) else None
    submit_settings(args.operation, payload, expected_revision=expected_rev)


def cmd_set_language(args: argparse.Namespace) -> None:
    submit_settings("set_language", {"language": args.language})


def cmd_gui(args: argparse.Namespace) -> None:
    from core.gui import run_gui
    run_gui(getattr(args, 'page_option', None) or args.page, getattr(args, 'delete', None), getattr(args, 'select', None))


def cmd_gui_data(args: argparse.Namespace) -> None:
    from core.gui import build_gui_payload, read_view
    if args.refresh and not read_view()['config_error']:
        response = send_daemon_cmd('refresh', timeout=60.0, retries=1)
        if not response.startswith(('OK', 'Daemon is not running')):
            raise RuntimeError(response)
    print(json.dumps(build_gui_payload(scan=args.scan, diagnostics=args.diagnostics,
                                      admin_checks=args.admin_checks, logs=args.logs), ensure_ascii=False))


def ask(prompt: str) -> str:
    answer = input(prompt).strip()
    if answer.lower() == "q":
        raise KeyboardInterrupt
    return answer


def choose_device(devices: list, label: str, optional: bool = False) -> dict:
    answer = ask(label + ("（Enter 略過，q 取消）: " if optional else "（q 取消）: "))
    if not answer and optional:
        return {}
    if not answer.isdecimal() or not 1 <= int(answer) <= len(devices):
        raise ValueError("請輸入清單內的編號；未儲存任何變更。")
    return devices[int(answer) - 1]


def cmd_pair(args: argparse.Namespace) -> None:
    print("\n📱 PadPilot 配對精靈 — q 或 Ctrl+C 可取消\n")
    cfg = load_config()
    bd_cli = BetterDisplayCLI(cfg.betterdisplaycli_path)
    detector = DisplayDetector(cfg, bd_cli)
    sidecars = bd_cli.get_sidecar_list()
    usbs = [u for u in detector.parse_usb_devices() if u.get("vendor_id") == 1452]
    print("Sidecar 裝置：")
    for i, d in enumerate(sidecars, 1):
        print(f"  [{i}] {d['name']} | {d['uuid']}")
    print("USB Apple 裝置（請自行確認對應 iPad）：")
    for i, d in enumerate(usbs, 1):
        print(f"  [{i}] {d.get('product_name') or d.get('name')} | {d.get('serial') or '無序號'}")
    for error in (getattr(bd_cli, "sidecar_error", ""), getattr(detector, "usb_error", "")):
        if error:
            print(f"⚠ 查詢狀態未知：{error}")
    if not args.interactive:
        print("使用 pair --interactive 開始配對。")
        return
    selected_uuid = getattr(args, "device", None)
    device = next((d for d in sidecars if selected_uuid and d['uuid'].upper() == selected_uuid.upper()), None)
    if not device and selected_uuid:
        device = next((p.to_dict() for p in cfg.paired_ipads if p.sidecar_uuid.upper() == selected_uuid.upper()), None)
    if not device:
        if not sidecars:
            raise ValueError("目前沒有可配對的 Sidecar 裝置；請確認 Apple Account 與連線後重試。")
        device = choose_device(sidecars, "選擇 Sidecar 編號")
    uuid = device.get('uuid') or device.get('sidecar_uuid', '')
    previous = next((p for p in cfg.paired_ipads if p.sidecar_uuid.upper() == uuid.upper()), None)
    usb = choose_device(usbs, "選擇對應 USB 編號", optional=True) if usbs else {}
    if usb and not usb.get('serial'):
        raise ValueError("所選 USB 裝置沒有序號；請重新執行並略過 USB 配對。")
    name = ask(f"裝置名稱（Enter 保留 {device['name']}）: ") or device['name']
    draft = {"name": name, "sidecar_uuid": uuid,
             "usb_serial": usb.get('serial') or (previous.usb_serial if previous else '')}
    print("\n準備儲存：")
    print(json.dumps(draft, indent=2, ensure_ascii=False))
    activate = ask("設為目前控制目標？依目前模式可能自動連線 [y/N]: ").lower() == 'y'
    cfg.remember_ipad(draft, activate)
    if ask("確認儲存 [y/N]: ").lower() != 'y':
        print("已取消，設定未變更。")
        return
    save_pairing(draft, activate)


def cmd_select_ipad(args: argparse.Namespace) -> None:
    cfg = load_config()
    target = next((p for p in cfg.paired_ipads if p.sidecar_uuid.upper() == args.uuid.upper()), None)
    if not target:
        raise ValueError("找不到此配對紀錄，請重新整理清單。")
    print(f"將控制目標改為 {target.name}。目前模式可能自動連線；原目標的暫時覆寫將清除。")
    if ask("確認切換 [y/N]: ").lower() == 'y':
        save_pairing(target.to_dict(), True)
    else:
        print("已取消。")


def cmd_set_ipad(args: argparse.Namespace) -> None:
    data = load_config().ipad.to_dict()
    for key in ('name', 'sidecar_uuid', 'usb_serial'):
        if getattr(args, key, None):
            data[key] = getattr(args, key)
    save_pairing(data, True)


def cmd_prefs(args: argparse.Namespace) -> None:
    cfg = load_config()
    if getattr(args, "open", False):
        subprocess.run(["open", str(get_config_file_path())], check=True)
        return
    print(f"Configuration file: {get_config_file_path()}\n")
    print(json.dumps(cfg.to_dict(), indent=2, ensure_ascii=False))


def cmd_open_log(args: argparse.Namespace) -> None:
    if getattr(args, "raw", False):
        log_file = get_log_file_path()
        if not log_file.exists():
            print(f"Log file does not exist yet at {log_file}")
            return
        subprocess.run(["open", str(log_file)])
        return
    from core.gui import run_gui
    run_gui("diagnostics")


def cmd_open_betterdisplay(args: argparse.Namespace) -> None:
    app = BetterDisplayCLI.resolve_app_path(load_config().betterdisplaycli_path)
    if not app:
        raise RuntimeError('BetterDisplay app not found; rerun the installer to select its path.')
    subprocess.run(["open", "-a", app], check=True)


def cmd_stop(args: argparse.Namespace) -> None:
    stop_daemon()
    for path in (APP_SUPPORT_DIR / "runtime" / "status.json",
                 Path("/tmp/PadPilot/runtime/status.json"), SOCKET_PATH):
        remove_state_file(path, socket_ok=path == SOCKET_PATH)
    print("✓ PadPilot 背景服務已停止。")


def cmd_exit(args: argparse.Namespace) -> None:
    args.exiting = True
    cmd_stop(args)
    atomic_write(MENU_HIDDEN, b'')
    print("✓ PadPilot 已離開 menu bar。重新開啟：padpilot-cli start")


def cmd_start(args: argparse.Namespace) -> None:
    print("Starting PadPilot daemon...")
    remove_state_file(MENU_HIDDEN)
    remove_state_file(Path("/tmp/PadPilot/menu-hidden"))
    if daemon_pids():
        wait_for_daemon()
        if not getattr(args, "no_menu", False):
            open_menu_app()
        print("✓ PadPilot 已在執行，已恢復選單。")
        return
    cfg = load_config()
    plist_path = Path.home() / "Library" / "LaunchAgents" / "com.padpilot.daemon.plist"
    if cfg.autostart_on_login:
        ok, message = enable_autostart()
        if not ok:
            raise RuntimeError(message)
    else:
        start_standalone()

    if not getattr(args, 'no_menu', False):
        open_menu_app()
    print("✓ PadPilot daemon has been started.")


def cmd_autostart(args: argparse.Namespace) -> None:
    action = getattr(args, "action", "status") or "status"
    if action == "status":
        enabled = is_autostart_enabled()
        status_str = "Enabled (will automatically run at login)" if enabled else "Disabled (will not run at login)"
        print(f"PadPilot Autostart: {status_str}")
    elif action == "enable":
        expected = getattr(args, 'expected_revision', None)
        ok, msg = enable_autostart(expected_revision=expected) if expected is not None else enable_autostart()
        print(msg)
    elif action == "disable":
        expected = getattr(args, 'expected_revision', None)
        ok, msg = disable_autostart(expected_revision=expected) if expected is not None else disable_autostart()
        print(msg)
    elif action == "toggle":
        ok, msg = toggle_autostart()
        print(msg)

    if action != "status" and not ok:
        raise RuntimeError(msg)


def main() -> None:
    parser = argparse.ArgumentParser(description="PadPilot Display Manager CLI")
    parser.add_argument("-v", "--version", action="version", version=f"PadPilot {__version__}")
    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

    p_runtime = subparsers.add_parser('runtime', help='Select Python for a release app; exit PadPilot before changing it')
    p_runtime.add_argument('mode', choices=['status', 'bundled', 'external'], nargs='?', default='status')
    p_runtime.add_argument('--python', help='Absolute path to an Apple Silicon CPython 3.10+ executable')
    def runtime_command(args):
        from core.runtime import set_python, read_preference
        if args.mode == 'status':
            print(json.dumps({'python': sys.executable, 'preference': read_preference()}, ensure_ascii=False))
            return
        if (args.mode == 'external') != bool(args.python):
            raise ValueError('Only external mode requires --python PATH')
        set_python(args.python)
        print('Python selection saved. Reopen PadPilot. / Python 選擇已儲存，請重新開啟 PadPilot。')
    p_runtime.set_defaults(func=runtime_command)

    p_uninstall = subparsers.add_parser('uninstall', help='Remove this release app and its LaunchAgent; preserve user data by default')
    p_uninstall.add_argument('--yes', action='store_true', required=True)
    p_uninstall.add_argument('--purge', action='store_true', help='Also move settings and logs to Trash')
    def uninstall_command(args):
        from core.runtime import bundled_app
        if bundled_app() is None:
            raise RuntimeError('Use scripts/uninstall.sh for a source installation')
        sys.path.insert(0, str(PROJECT_ROOT / 'scripts'))
        from manage_app import manage
        manage(uninstall=True, purge=args.purge)
    p_uninstall.set_defaults(func=uninstall_command)

    p_gui = subparsers.add_parser("gui", help="Open graphical settings and pairing management window")
    p_gui.add_argument("page", nargs="?", default="paired", help="Initial tab")
    p_gui.add_argument("--page", dest="page_option", help="Initial tab (alias)")
    p_gui.add_argument("--delete", help="Show confirmation for a saved profile key")
    p_gui.add_argument("--select", help="Show confirmation for a saved target key")
    p_gui.set_defaults(func=cmd_gui)
    p_change = subparsers.add_parser("change-settings", help="Apply a validated JSON settings command from stdin")
    p_change.add_argument("operation", choices=["save_pairing", "delete_pairing", "set_virtual_display", "set_betterdisplaycli_path", "set_usb_event_wakeup", "set_auto_detect_ipad", "set_language", "set_mode", "set_connection_hotkey", "set_connect_on_boot"])
    p_change.set_defaults(func=cmd_change_settings)
    p_data = subparsers.add_parser('gui-data', help='Read native settings presentation data as JSON')
    for flag in ('scan', 'diagnostics', 'admin-checks', 'logs', 'refresh'):
        p_data.add_argument('--' + flag, action='store_true')
    p_data.set_defaults(func=cmd_gui_data)

    # start
    p_start = subparsers.add_parser("start", help="Start the background daemon")
    p_start.add_argument("--no-menu", action="store_true", help=argparse.SUPPRESS)
    p_start.set_defaults(func=cmd_start)

    p_menu = subparsers.add_parser("menu-json", help="Read the native menu model without querying hardware")
    def menu_json(args):
        from core.menu import main
        main()
    p_menu.set_defaults(func=menu_json)

    p_exit = subparsers.add_parser("exit", help="Stop daemon and hide only PadPilot from menu bar")
    p_exit.set_defaults(func=cmd_exit)

    # stop
    p_stop = subparsers.add_parser("stop", help="Stop the background daemon")
    p_stop.set_defaults(func=cmd_stop)

    # autostart
    p_auto = subparsers.add_parser("autostart", help="Manage daemon autostart on login (status/enable/disable/toggle)")
    p_auto.add_argument(
        "action",
        nargs="?",
        default="status",
        choices=["enable", "disable", "toggle", "status"],
        help="Autostart action (default: status)",
    )
    p_auto.set_defaults(func=cmd_autostart)
    p_auto.add_argument('--expected-revision', type=int)

    # status
    p_status = subparsers.add_parser("status", help="Show current display and automation status")
    p_status.add_argument("--json", action="store_true", help="Output raw JSON status")
    p_status.set_defaults(func=cmd_status)

    # set-mode
    p_mode = subparsers.add_parser("set-mode", help="Change operational mode")
    p_mode.add_argument("mode", choices=["automatic", "manual_only", "prefer_ipad"])
    p_mode.set_defaults(func=cmd_set_mode)

    # set-language
    p_lang = subparsers.add_parser("set-language", help="Set interface display language")
    p_lang.add_argument("language", choices=["en", "zh-Hant", "ja"], help="Language code (en, zh-Hant, ja)")
    p_lang.set_defaults(func=cmd_set_language)

    # action
    p_act = subparsers.add_parser("action", help="Trigger an immediate action")
    p_act.add_argument(
        "action",
        choices=[
            "use_ipad_secondary",
            "use_ipad_main",
            "disconnect_ipad",
            "reconnect_sidecar",
            "connect_ipad",
            "refresh",
            "reset",
        ],
    )
    p_act.set_defaults(func=cmd_action)
    p_act.add_argument('--expected-revision', type=int)
    p_act.add_argument('--target-key')

    # pair
    p_pair = subparsers.add_parser("pair", help="Scan and pair connected iPad")
    p_pair.add_argument("--interactive", "-i", action="store_true", help="Run interactive pairing wizard")
    p_pair.add_argument("--device", help="Preselect a discovered or saved Sidecar UUID")
    p_pair.set_defaults(func=cmd_pair)

    p_select = subparsers.add_parser("select-ipad", help="Select a saved control target with confirmation")
    p_select.add_argument("uuid")
    p_select.set_defaults(func=cmd_select_ipad)

    # set-ipad
    p_set_ipad = subparsers.add_parser("set-ipad", help="Directly set iPad configuration")
    p_set_ipad.add_argument("--name", help="iPad Display Name")
    p_set_ipad.add_argument("--sidecar-uuid", help="Sidecar UUID")
    p_set_ipad.add_argument("--usb-serial", help="USB Serial number")
    p_set_ipad.set_defaults(func=cmd_set_ipad)

    # prefs
    p_prefs = subparsers.add_parser("prefs", help="View preferences")
    p_prefs.add_argument("--open", action="store_true", help="Open configuration in its default editor")
    p_prefs.set_defaults(func=cmd_prefs)

    # open-log
    p_log = subparsers.add_parser("open-log", help="Open PadPilot status & diagnostics in GUI (or use --raw for file)")
    p_log.add_argument("--raw", action="store_true", help="Open raw log file in Console/TextEdit")
    p_log.set_defaults(func=cmd_open_log)
    p_bd = subparsers.add_parser("open-betterdisplay", help="Open BetterDisplay")
    p_bd.set_defaults(func=cmd_open_betterdisplay)

    args = parser.parse_args()
    if not args.subcommand:
        # Default to status if no subcommand provided
        cmd_status(argparse.Namespace(json=False))
    else:
        args.func(args)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print("\n已取消。")
    except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as error:
        shortcut_request = sys.argv[1:3] == ['action', 'connect_ipad']
        print(str(error) if shortcut_request else f"錯誤：{error}", file=sys.stderr)
        # The native shortcut owns its error banner; a second CLI notification
        # would duplicate it and use the generic "Operation Failed" subtitle.
        if not shortcut_request:
            from core.notifier import notify_error
            notify_error(str(error), subtitle="PadPilot Operation Failed")
        sys.exit(1)
